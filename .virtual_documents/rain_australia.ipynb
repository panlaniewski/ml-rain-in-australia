df["Date"] = pd.to_datetime(df["Date"])

df['Year'] = df['Date'].dt.year
df['Month'] = df['Date'].dt.month





def month_to_season(month):
    if month in [12, 1, 2]:
        return "Summer"
    elif month in [3, 4, 5]:
        return "Autumn"
    elif month in [6, 7, 8]:
        return "Winter"
    else:
        return "Spring"

df["Season"] = df["Month"].apply(month_to_season)






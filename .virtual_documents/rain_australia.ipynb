








import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
sns.set_style('darkgrid')
get_ipython().run_line_magic("matplotlib", " inline")





df = pd.read_csv("weatherAUS.csv")





df.head()








df.tail()








df.shape








df.info()








df.describe()





df.select_dtypes(include="str").nunique()








missing = df.isna().sum().sort_values(ascending=False)
missing_pct = (df.isna().mean() * 100).round(2).sort_values(ascending=False)
 
pd.DataFrame({"n_missing": missing, "pct_missing": missing_pct}).query("n_missing > 0")








df.groupby("Location").apply(lambda g: g.isna().mean() * 100).round(2)[
    ["Evaporation", "Sunshine", "Cloud9am", "Cloud3pm"]
]








import missingno as msno

msno.matrix(df)
plt.show()

msno.heatmap(df)
plt.show()








before = len(df)
df = df.dropna(subset=["RainTomorrow", "RainToday"])
print(f"Удалено строк: {before - len(df)} ({(before - len(df)) / before * 100:.1f}%)")





df['RainTomorrow'].isnull().sum()





cols_with_missing = df.columns[df.isna().any()].tolist()

for col in cols_with_missing:
    df[f"{col}_was_missing"] = df[col].isna().astype(int)
 
df[[c for c in df.columns if "_was_missing" in c]].sum().sort_values(ascending=False)





df["Date"] = pd.to_datetime(df["Date"])

df['Year'] = df['Date'].dt.year
df['Month'] = df['Date'].dt.month





def month_to_season(month):
    if month in [12, 1, 2]:
        return "Summer"
    elif month in [3, 4, 5]:
        return "Autumn"
    elif month in [6, 7, 8]:
        return "Winter"
    else:
        return "Spring"

df["Season"] = df["Month"].apply(month_to_season)





target_col = "RainTomorrow"
flag_cols = [c for c in df.columns if c.endswith("_was_missing")]
cat_cols = df.select_dtypes(include="str").columns.difference([target_col]).tolist()
num_cols = df.select_dtypes(include=np.number).columns.difference(flag_cols).tolist()





sns.countplot(data=df, x=target_col)


df['RainTomorrow'].value_counts(normalize=True) 








n_cols = 3
n_rows = -(-len(cat_cols) // n_cols)  

fig, axes = plt.subplots(n_rows, n_cols, figsize=(6 * n_cols, 4 * n_rows))
axes = axes.flatten()

for i, col in enumerate(cat_cols):
    top_categories = df[col].value_counts().head(10).index  
    sns.countplot(data=df, x=col, order=top_categories, ax=axes[i])
    axes[i].set_title(col)
    axes[i].tick_params(axis="x", rotation=90)

for j in range(i + 1, len(axes)):
    fig.delaxes(axes[j]) 

plt.tight_layout()
plt.show()





n_cols = 3
n_rows = -(-len(num_cols) // n_cols)  

fig, axes = plt.subplots(n_rows, n_cols, figsize=(6 * n_cols, 4 * n_rows))
axes = axes.flatten()

for i, col in enumerate(num_cols):
    sns.histplot(data=df, x=col, ax=axes[i], kde=True)
    axes[i].set_title(col)

for j in range(i + 1, len(axes)):
    fig.delaxes(axes[j]) 

plt.tight_layout()
plt.show()








df[flag_cols].mean().sort_values(ascending=False).plot(kind="barh")
plt.xlabel("Доля пропусков")
plt.show()





boxplot_cols = ["Humidity9am", "Humidity3pm", "Pressure9am", "Pressure3pm", "Cloud9am", "Cloud3pm", "Sunshine", "Rainfall"]

n_cols = 2
n_rows = -(-len(boxplot_cols) // n_cols)  

fig, axes = plt.subplots(n_rows, n_cols, figsize=(6 * n_cols, 4 * n_rows))
axes = axes.flatten()

for i, col in enumerate(boxplot_cols):
    sns.boxplot(data=df, x="RainTomorrow", y=col, ax=axes[i])
    axes[i].set_title(col)

for j in range(i + 1, len(axes)):
    fig.delaxes(axes[j]) 

plt.tight_layout()
plt.show()





top_categories = df["Location"].value_counts().head(10).index
sns.countplot(data=df, x="Location", hue="RainTomorrow", order=top_categories)
plt.xticks(rotation=90)
plt.show()


rain_ratio = (
    df.groupby("Location")["RainTomorrow"]
    .value_counts(normalize=True)
    .unstack()
)

top_rainy = rain_ratio.sort_values("Yes", ascending=False).head(10)
top_dry = rain_ratio.sort_values("Yes", ascending=True).head(10)

print("Самые дождливые:\n", top_rainy)
print("\nСамые засушливые:\n", top_dry)


sns.countplot(data=df, x="Season", hue="RainTomorrow")
plt.show()


rain_ratio = (
    df.groupby("Season")["RainTomorrow"]
    .value_counts(normalize=True)
    .unstack()
)

top_rainy = rain_ratio.sort_values("Yes", ascending=False)
top_dry = rain_ratio.sort_values("Yes", ascending=True)

print("Самые дождливые:\n", top_rainy)
print("\nСамые засушливые:\n", top_dry)


